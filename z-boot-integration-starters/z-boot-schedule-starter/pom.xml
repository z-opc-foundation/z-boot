<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-integration-starters</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>z-boot-schedule-starter</artifactId>
    <name>z-boot-schedule-starter</name>
    <description>
        z-boot Schedule 聚合 starter — 一行 import 集成 z-schedule 分布式任务调度系统
        (对标 XXL-Job: AutoConfiguration + 集群协调 Leader/ScheduleRing + REST API).
    </description>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-boot.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-boot.git</developerConnection>
        <url>https://github.com/yuku123/z-boot</url>
        <tag>HEAD</tag>
    </scm>
    <url>https://github.com/yuku123/z-boot</url>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- z-schedule 版本用顶层 pom 的 <z-schedule.version>。这里原有份副本，注释自己写着
             "须与根 pom 同步"——手抄两份正是漂移的成因，且删掉不改变产物：2026-09-26 两侧实测同为 1.0.4。 -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-schedule-spring-boot-starter</artifactId>
            <version>${z-schedule.version}</version>
        </dependency>
    </dependencies>
</project>
