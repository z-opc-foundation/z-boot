<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-integration-starters</artifactId>
        <version>1.0.23</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>z-boot-script-starter</artifactId>
    <version>1.0.23</version>
    <name>z-boot :: script-starter (z-script 脚本/Mock 引擎内嵌)</name>
    <description>z-boot z-script 聚合 starter — 一行 import 把 z-script 的脚本引擎、HTTP 暴露、
        Mock 分发与 app+AK 鉴权内嵌进业务应用（进程内运行，无需独立部署 z-script-admin）.</description>
    <url>https://github.com/yuku123/z-boot</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:git://github.com/yuku123/z-boot.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-boot.git</developerConnection>
        <url>https://github.com/yuku123/z-boot</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-dependencies</artifactId>
                <version>1.0.20</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 兄弟仓(z-* L3)版本权威:与地板坐标空间不相交,抬兄弟版只重发 fleet -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-fleet</artifactId>
                <version>1.0.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 经 z-z-msg/z-schedule/z-script 传递进来的 z-boot 自家件,在本叶子钉到当次 cut,
                 免得同一坐标在 z-opc 全树上出现两个 z-boot-* 版本 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-datasource-starter</artifactId>
                <version>1.0.23</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-web-starter</artifactId>
                <version>1.0.23</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- z-script 全量（web 传递 core/engine，版本由 z-boot-fleet BOM 锁）。
             z-script-web 自带 spring.factories 自动装配：ComponentScan com.zifang.z.script + 引擎 bean。
             本 starter 与仓内 config/cache 等 starter 同款直通模式：只聚合依赖 + 标记类，不重复注册 bean。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-script-web</artifactId>
            <exclusions>
                <!-- 不替消费者把 log4j2 到 slf4j2 的绑定摊出去：z-util-core / z-gw-core 的发布 pom 里
                     log4j-slf4j2-impl 是 compile 直接依赖，用默认 logback 的 Boot 应用在
                     SpringApplication 初始化就抛 log4j-slf4j2-impl cannot be present with log4j-to-slf4j。
                     要 log4j2 后端请引 z-boot-web-starter（它经 spring-boot-starter-log4j2 正规地带绑定）。 -->
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
