<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-integration-starters</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>z-boot-script-starter</artifactId>
    <name>z-boot :: script-starter (z-script 脚本/Mock 引擎内嵌)</name>
    <description>z-boot z-script 聚合 starter — 一行 import 把 z-script 的脚本引擎、HTTP 暴露、
        Mock 分发与 app+AK 鉴权内嵌进业务应用（进程内运行，无需独立部署 z-script-admin）.</description>
    <url>https://github.com/yuku123/z-boot</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:git://github.com/yuku123/z-boot.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-boot.git</developerConnection>
        <url>https://github.com/yuku123/z-boot</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- z-script 全量（web 传递 core/engine，版本由父 dependencyManagement 锁）。
             z-script-web 自带 spring.factories 自动装配：ComponentScan com.zifang.z.script + 引擎 bean。
             本 starter 与仓内 config/cache 等 starter 同款直通模式：只聚合依赖 + 标记类，不重复注册 bean。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-script-web</artifactId>
        </dependency>
    </dependencies>
</project>
