<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot</artifactId>
        <version>1.0.19</version>
        <relativePath>../pom.xml</relativePath>
    </parent>


    <artifactId>z-boot-integration-starters</artifactId>
    <version>1.1.1</version>
    <packaging>pom</packaging>
    <name>z-boot-integration-starters (Aggregator)</name>
    <description>
        集成型 Spring Boot Starter 聚合 — 包装 z-opc L3 中间件 (z-config / z-cache / z-mq /
        z-gw / z-kb / z-vector / z-graph / z-rpc / z-oss) + z-opc 内部 client SDK, 供 z-opc
        业务模块一行 import 即可拿到对应中间件能力, 也供外部应用快速集成已发布的 z-* 服务。
    </description>

    <modules>
        <!-- L3 中间件聚合 starter: 每个 z-boot-* 封装对应 L3 的 spring-boot-starter,
             业务模块只需引入 z-boot-cache-starter 等就能拿到 z-cache 客户端等。 -->
        <module>z-boot-config-starter</module>
        <module>z-boot-cache-starter</module>
        <module>z-boot-mq-starter</module>
        <module>z-boot-gw-starter</module>
        <module>z-boot-kb-starter</module>
        <module>z-boot-vector-starter</module>
        <module>z-boot-graph-starter</module>
        <module>z-boot-rpc-starter</module>
        <module>z-boot-oss-starter</module>
        <module>z-boot-schedule-starter</module>
        <module>z-boot-msg-starter</module>

        <!-- 集成型 starter: 包装 z-opc 自身 client SDK (z-config / z-ctc / z-ext /
             z-lc / z-mist / z-rpc-client / z-webide)。业务模块可单独引入。
             2026-10-06: z-boot-jackson-starter 从这里移出（模块整体删除），它的内容
             (GlobalJacksonConfig + spring.factories) 已内化进 z-boot-starter/z-boot-web-starter。
             原因见 z-boot-web-starter/pom.xml 里那段注释——它作为独立件会让两个容器互相依赖，
             任何发布顺序都无解。 -->
        <module>z-boot-ctc-starter</module>
        <!-- z-script-web 1.0.0 实测已在 Central（空仓 dependency:resolve BUILD SUCCESS），
             所以 script-starter 从 1.0.15 起进 reactor 一起发。 -->
        <module>z-boot-script-starter</module>
        <!-- 2026-10-07 删除 z-tool-webide-spring-boot-starter/（残骸收口）。它停在命名空间迁移之前：
             <parent> 写死 1.0.1（聚合件早已 1.0.25）、自身 <version>1.0.1</version>、DM 用
             ${project.parent.version} 去 import z-boot-dependencies（那一格 repo1 上是空的）、三条
             z-tool-webide-* 依赖无人供版本（fleet 22 族里没有 webide 格）⇒ 放开 <module> 会让整个
             reactor 读不起 pom。全仓零真实消费方（z-opc 只有 6 条 dependencyManagement 死行）。
             webide 的自动装配本就归被 bind 的仓：z-webide/z-tool-webide-web 自带
             META-INF/spring.factories。将来若要在这里挂 starter，按 _doc/001_arch/AGENTS.md
             「新增 starter」从头开一个，别复活那份旧 pom（旧内容可由 git 找回）。 -->

        <!-- FEATURE066: L3 Agent/AI 7 仓聚合 starter -->
        <module>z-boot-llm-starter</module>
        <module>z-boot-mcp-starter</module>
        <module>z-boot-skill-starter</module>
        <module>z-boot-agent-starter</module>
        <module>z-boot-bot-starter</module>
        <module>z-boot-agent-proxy-starter</module>
    </modules>

    <!-- 兄弟仓(z-* L3)的版本格不在这里 —— 1.0.18 之前这里是 36 行受管项,于是"抬一格兄弟仓
         版本"必须重发整个 z-boot。现在权威搬进 z-boot-fleet(由 _doc/003_script/gen_fleet_bom.py
         生成、逐件对 repo1 复核),叶子 pom 各自 import 地板 + fleet 两个字面版本,聚合 pom 不再管版本。 -->

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

</project>
