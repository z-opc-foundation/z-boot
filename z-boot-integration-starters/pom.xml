<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot</artifactId>
        <version>1.0.19</version>
        <relativePath>../pom.xml</relativePath>
    </parent>


    <artifactId>z-boot-integration-starters</artifactId>
    <version>1.0.21</version>
    <packaging>pom</packaging>
    <name>z-boot-integration-starters (Aggregator)</name>
    <description>
        集成型 Spring Boot Starter 聚合 — 包装 z-opc L3 中间件 (z-config / z-cache / z-mq /
        z-gw / z-kb / z-vector / z-graph / z-rpc / z-oss) + z-opc 内部 client SDK, 供 z-opc
        业务模块一行 import 即可拿到对应中间件能力, 也供外部应用快速集成已发布的 z-* 服务。
    </description>

    <modules>
        <!-- L3 中间件聚合 starter: 每个 z-boot-* 封装对应 L3 的 spring-boot-starter,
             业务模块只需引入 z-boot-cache-starter 等就能拿到 z-cache 客户端等。 -->
        <module>z-boot-config-starter</module>
        <module>z-boot-cache-starter</module>
        <module>z-boot-mq-starter</module>
        <module>z-boot-gw-starter</module>
        <module>z-boot-kb-starter</module>
        <module>z-boot-vector-starter</module>
        <module>z-boot-graph-starter</module>
        <module>z-boot-rpc-starter</module>
        <module>z-boot-oss-starter</module>
        <module>z-boot-schedule-starter</module>
        <module>z-boot-msg-starter</module>

        <!-- 集成型 starter: 包装 z-opc 自身 client SDK (z-config / z-ctc / z-ext /
             z-lc / z-mist / z-rpc-client / z-webide)。业务模块可单独引入。 -->
        <module>z-boot-jackson-starter</module>
        <module>z-boot-ctc-starter</module>
        <!-- z-script-web 1.0.0 实测已在 Central（空仓 dependency:resolve BUILD SUCCESS），
             所以 script-starter 从 1.0.15 起进 reactor 一起发。 -->
        <module>z-boot-script-starter</module>
        <!-- z-tool-webide-spring-boot-starter 不能进 reactor：它的 pom 还停在命名空间迁移之前。
             2026-09-26 本机复跑（把下面那行 <module> 放开 → `mvn -B -o validate` = rc=1，
             且是"整个 reactor 读不起"级别，5 条 ERROR 原文）：
               Non-resolvable import POM: com.zifang:z-boot-dependencies:pom:1.0.1 (absent)  [它的 <parent> 写死 1.0.1，不吃 ${revision}]
               'dependencies.dependency.version' for com.zifang:z-tool-webide-{docker,api,common}:jar is missing
               'dependencies.dependency.version' for org.springframework.boot:spring-boot-autoconfigure:jar is missing
             ⚠ 第二条别读成"这里没管版本"：本聚合 pom 232-250 行**已经**管了
             io.github.yuku123:z-tool-webide-{common,api,core,docker} = ${project.version}，
             报 missing 是因为 starter 写的是 com.zifang 组 ⇒ groupId 对不上、约束落不到它身上。
             被包装的 L3 源码在哪：sibling 仓 z-opc-foundation/z-webide（parent com.zifang:z-tool:1.0.0-SNAPSHOT，
             模块 common/api/core/docker/web/k8s），repo1 上 com.zifang 和 io.github.yuku123 两个 groupId
             实测都 404 ⇒ 今天没有任何一条路能把它放进 reactor。
             再入门条件（放进来前先逐条满足，缺一条就是上面那 5 条红）：
               1) z-webide 以 io.github.yuku123 发 Central，版本与本仓 <revision> 对齐（`${project.version}` 才管得到）；
               2) 本 starter pom：三行依赖 groupId 换 io.github.yuku123、<parent> 版本换 ${revision}、
                  那段 import 换 io.github.yuku123:z-boot-dependencies:${revision}；
               3) 放开下面这行 <module> 并复跑本仓 README 的 tree-vs-pom 尺（它会把"盘上有 pom 但未进 module"列出来）。 -->
        <!-- <module>z-tool-webide-spring-boot-starter</module> -->

        <!-- FEATURE066: L3 Agent/AI 7 仓聚合 starter -->
        <module>z-boot-llm-starter</module>
        <module>z-boot-mcp-starter</module>
        <module>z-boot-skill-starter</module>
        <module>z-boot-agent-starter</module>
        <module>z-boot-bot-starter</module>
        <module>z-boot-agent-proxy-starter</module>
    </modules>

    <!-- 兄弟仓(z-* L3)的版本格不在这里 —— 1.0.18 之前这里是 36 行受管项,于是"抬一格兄弟仓
         版本"必须重发整个 z-boot。现在权威搬进 z-boot-fleet(由 _doc/003_script/gen_fleet_bom.py
         生成、逐件对 repo1 复核),叶子 pom 各自 import 地板 + fleet 两个字面版本,聚合 pom 不再管版本。 -->

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

</project>
