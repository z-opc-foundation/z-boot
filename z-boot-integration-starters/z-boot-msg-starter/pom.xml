<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-integration-starters</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>z-boot-msg-starter</artifactId>
    <name>z-boot-msg-starter</name>
    <description>
        z-boot MSG 聚合 starter — 一行 import 集成 z-msg 多通道消息下发系统
        (短信/邮件/In-app/Push/Webhook/IM: 统一 MessageGateway SPI + 多 Provider + REST API).
    </description>
    <url>https://github.com/z-opc-foundation/z-boot</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-boot.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/z-opc-foundation/z-boot.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-boot</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 子 pom 自包含版本号, 顶层 ${revision} flatten 后 z-msg.version 才可解析 -->
        <z-msg.version>1.0.0</z-msg.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            z-msg-web: Spring Boot REST Controllers + AutoConfiguration (spring.factories 注册 MsgAutoConfiguration)
            业务模块一行 import 即可开启消息下发 HTTP API + 自动装配
        -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-msg-web</artifactId>
            <version>${z-msg.version}</version>
        </dependency>
    </dependencies>
</project>