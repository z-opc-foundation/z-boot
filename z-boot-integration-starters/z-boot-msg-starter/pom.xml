<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-integration-starters</artifactId>
        <version>1.0.19</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>z-boot-msg-starter</artifactId>
    <version>1.0.19</version>
    <name>z-boot-msg-starter</name>
    <description>
        z-boot MSG 聚合 starter — 一行 import 集成 z-msg 多通道消息下发系统
        (短信/邮件/In-app/Push/Webhook/IM: 统一 MessageGateway SPI + 多 Provider + REST API).
    </description>
    <url>https://github.com/z-opc-foundation/z-boot</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-boot.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/z-opc-foundation/z-boot.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-boot</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- z-msg 版本一律用顶层 pom 的 <z-msg.version>，这里不再重复声明：
             2026-09-26 实测顶层抬到 1.1.0 后 dependency:tree 仍解析出 1.0.0，
             就是因为这里有一份子 pom 副本在遮蔽父 property（flatten 会把生效值折成字面量，
             所以"自包含"不是需要副本的理由）。 -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-dependencies</artifactId>
                <version>1.0.19</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 兄弟仓(z-* L3)版本权威:与地板坐标空间不相交,抬兄弟版只重发 fleet -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-fleet</artifactId>
                <version>1.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 经 z-z-msg/z-schedule/z-script 传递进来的 z-boot 自家件,在本叶子钉到当次 cut,
                 免得同一坐标在 z-opc 全树上出现两个 z-boot-* 版本 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-datasource-starter</artifactId>
                <version>1.0.19</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-web-starter</artifactId>
                <version>1.0.19</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            z-msg-web: Spring Boot REST Controllers + AutoConfiguration (spring.factories 注册 MsgAutoConfiguration)
            业务模块一行 import 即可开启消息下发 HTTP API + 自动装配
        -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-msg-web</artifactId>
        </dependency>
    </dependencies>
</project>