<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-integration-starters</artifactId>
        <version>1.1.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>z-boot-msg-starter</artifactId>
    <version>1.1.1</version>
    <name>z-boot-msg-starter</name>
    <description>
        z-boot MSG 聚合 starter — 一行 import 集成 z-msg 多通道消息下发系统
        (短信/邮件/In-app/Push/Webhook/IM: 统一 MessageGateway SPI + 多 Provider + REST API).
    </description>
    <url>https://github.com/z-opc-foundation/z-boot</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-boot.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/z-opc-foundation/z-boot.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-boot</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- z-msg 版本一律用顶层 pom 的 <z-msg.version>，这里不再重复声明：
             2026-09-26 实测顶层抬到 1.1.0 后 dependency:tree 仍解析出 1.0.0，
             就是因为这里有一份子 pom 副本在遮蔽父 property（flatten 会把生效值折成字面量，
             所以"自包含"不是需要副本的理由）。 -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 唯一版本供给：parent-as-BOM（第三方地板 + 接入面 + 自家火车全在这里） -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-parent</artifactId>
                <version>1.1.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            z-msg-web: Spring Boot REST Controllers + AutoConfiguration (spring.factories 注册 MsgAutoConfiguration)
            业务模块一行 import 即可开启消息下发 HTTP API + 自动装配
        -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-msg-web</artifactId>
                <version>1.2.2</version>
            <exclusions>
                <!-- 不替消费者把 log4j2 到 slf4j2 的绑定摊出去：z-util-core / z-gw-core 的发布 pom 里
                     log4j-slf4j2-impl 是 compile 直接依赖，用默认 logback 的 Boot 应用在
                     SpringApplication 初始化就抛 log4j-slf4j2-impl cannot be present with log4j-to-slf4j。
                     要 log4j2 后端请引 z-boot-web-starter（它经 spring-boot-starter-log4j2 正规地带绑定）。 -->
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>