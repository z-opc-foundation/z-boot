                </exclusions>
            </dependency>

            <!-- 2026-09-04 fix：在 spring-boot-dependencies 之后显式导入 jackson-bom 2.18.6，
                 因为 Maven dependencyManagement 中「先声明者获胜」，
                 Spring Boot 2.7.12 BOM 会把 jackson-annotations 拉成 2.13.x，
                 与本地升级的 jackson-databind 2.18.6 不兼容，导致 Netty JSON 反序列化
                 抛 NoSuchFieldError: JsonFormat$Feature.READ_UNKNOWN_ENUM_VALUES_USING_DEFAULT_VALUE。
                 jackson-bom 必须出现在 spring-boot-dependencies 之后才能覆盖其中的 Jackson 版本。 -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.18.6</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

