    <!--
        BOM artifact 必须用 resolveCiFriendliesOnly 而非 oss:
        oss 模式会把 dependencyManagement 全部剥掉, 造成子模块无法从 BOM 解析第三方版本
        (例: spring-boot-autoconfigure 缺失 version → Central 校验失败)。
        resolveCiFriendliesOnly 只解析 ${revision}/${sha1}/${changelist}/${tag},
        保留 BOM transitive imports, 业务模块继续用 oss 模式产出 self-contained POM。
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
            </plugin>
        </plugins>
    </build>

