<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-boot-parent —— 消费入口：一行 <parent> 就拿到"地板 + fleet + 构建口径"。

        形状照 c2f-boot 的 c2f-boot-parent → c2f-boot-dependencies 那一层（1.0.19 抄了它的
        拓扑，但没抄消费模型）：
          继承 z-boot-dependencies  ⇒ 白拿 156 条第三方地板（spring-boot/netty/jackson/log4j2…）
          本 pom 再 import z-boot-fleet ⇒ 白拿 163 条兄弟仓 z-* 版本格
          本 pom 补 pluginManagement ⇒ Java 8 口径、编码、-parameters、surefire/boot 插件版本
        使用方从此不写 <dependencyManagement>、不写版本属性（现状是每个仓自己起名字：
        z-util.version 13 仓 / util.version 7 仓 / zutil.version 1 仓，还各自漏钉 z-util）。

        三个和"发布件对外可见"直接相关的决定，改之前先读：
        1) flatten 在这里覆盖成 resolveCiFriendliesOnly，不用根 pom 的 oss —— oss 会剥掉
           <build>/<pluginManagement>，那样发出去的 parent 就只剩版本、没有构建口径，
           而本机永远看不出来（同 fleet 那条"别在 fleet 上用 oss"的教训）。
        2) z-boot 自家 starter 的版本键必须是**字面 property** <z-boot.version>，不能照
           spring-boot-dependencies 那样用 ${project.version}：resolveCiFriendliesOnly 只解
           ${revision}/${sha1}/${changelist}，${project.version} 会原样留在发出去的 pom 里，
           于是消费方按**它自己的**版本去解析。2026-09-28 在隔离 repo
           (-Dmaven.repo.local=/tmp/zboot-parent-repo) 实测：一个 version=9.9.9-PROBE 的探针
           工程从本 parent 拿到的 z-boot-web-starter 就是 9.9.9-PROBE（404），不是 1.0.19。
        3) 不放 maven.deploy.skip —— 它挡不住任何东西：distributionManagement 只在 -Pcentral 里
           才有（根 pom 第 92 行），不带 profile 的 `mvn deploy` 本来就报 "repository element
           was not specified"；而按 central_pom_scan 的 B 类口径，central-publishing 插件"不认
           skip"，真发布时它同样不生效。留一个两处都不生效的开关只会误导下一个人。
    -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-dependencies</artifactId>
        <version>1.0.20</version>
        <relativePath>../z-boot-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>z-boot-parent</artifactId>
    <version>1.0.22</version>
    <packaging>pom</packaging>

    <name>z-boot-parent (Consumer Parent)</name>
    <description>z-opc-foundation 各仓的统一 parent：继承第三方地板 BOM、导入兄弟仓版本权威 fleet，并下发 Java 8 构建口径</description>

    <properties>
        <!-- fleet 的落点。fleet 是脚本产物（_doc/003_script/gen_fleet_bom.py），只钉 repo1 实测
             存在的版本；fleet 内容变了就抬这一格并重发 fleet 文件夹。 -->
        <z-boot-fleet.version>1.0.1</z-boot-fleet.version>
        <!-- z-boot 自家 starter 的落点：与本 parent 自己的 <version> 同格（同一个仓、一起发版）。
             由 gen_fleet_bom.py 的 write-parent 逐件对 repo1 复核后落笔，别手改。 -->
        <z-boot.version>1.0.21</z-boot.version>

        <java.version>1.8</java.version>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <maven-compiler-plugin.version>3.11.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>2.22.2</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>2.22.2</maven-failsafe-plugin.version>
        <maven-jar-plugin.version>3.3.0</maven-jar-plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
        <spring-boot.version>2.7.18</spring-boot.version>
        <!-- 显式钉住：链上的 z-boot-dependencies / z-boot 发布件被 oss 剥过 <build>，没有一处给
             flatten 兜版本 ⇒ 消费方继承到一条无 version 的插件声明（Maven 直接 WARNING，也就是
             central_pom_scan 的 E 类）。这一格把链补严。 -->
        <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-fleet</artifactId>
                <version>${z-boot-fleet.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- BEGIN z-boot-self (由 gen_fleet_bom.py 的 write-parent 维护，勿手改) -->
            <!-- z-boot 1.0.21:清单取自 z-boot-starter + z-boot-integration-starters 的 <modules>,版本逐件核过 repo1 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-agent-proxy-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-agent-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-base</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-bot-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-cache-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-config-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-ctc-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-datasource-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-graph-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-gw-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-jackson-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-kb-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-llm-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-mcp-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-mq-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-msg-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-oss-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-rpc-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-schedule-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-script-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-skill-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-vector-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-web-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <!-- END z-boot-self -->
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <!-- Spring 的构造器注入/@ConfigurationProperties 绑定靠参数名，
                             各仓现在靠自己的 <compilerArgs> 各抄一遍，这里统一 -->
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                    <configuration>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- 覆盖父 pom 的 flatten 绑定：见头部注释 1，只解 CI-friendly 版本，
                 保住 <build>/<pluginManagement>/<dependencyManagement> -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <!-- 只为本 pom 自己服务：inherited=false 免得把一条 flatten 声明塞给全组织
                     30 个仓（它们发的是非扁平 pom，凭空继承一条插件声明没有好处只有惊讶）。 -->
                <inherited>false</inherited>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
