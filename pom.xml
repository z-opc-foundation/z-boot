<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-boot 是 z-opc-foundation 的版本权威 (BOM) 自给自足, 不依赖任何 z-opc 业务模块。
        发版模式：reversion (CI-friendly versions) + flatten-maven-plugin。
        发版只需改顶层 <revision>X.Y.Z</revision> 一处。
    -->
    <groupId>io.github.yuku123</groupId>
    <artifactId>z-boot</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>z-boot (Starter Parent + BOM Authority)</name>
    <description>z-opc-foundation 的 Spring Boot Starter 聚合 + 第三方依赖版本权威 (BOM)</description>
    <url>https://github.com/z-opc-foundation/z-boot</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-boot.git</connection>
        <developerConnection>scm:ssh://git@github.com/z-opc-foundation/z-boot.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-boot</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>z-boot-starter</module>
        <module>z-boot-dependencies</module>
        <module>z-boot-integration-starters</module>
    </modules>

    <!--
      z-boot 子模块的 dependencyManagement 在各子 pom 自己声明 (import z-boot-dependencies BOM).
      z-opc 等消费者通过 import z-boot-dependencies BOM 也能拿到版本约束.
      这里不放 import 是为了避免与子模块自身继承形成 cycle.
    -->

    <properties>
        <!-- 项目自身版本（CI-friendly versions 根，发版改这一处即可） -->
        <revision>1.0.16</revision>

        <!-- JDK / 编译 -->
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- z-opc-foundation 生态版本（消费者也通过 properties 引用）。
             对账基准 = repo1 每个 L3 坐标的 maven-metadata（<latest> 与 <versions> 最大值都算，
             因为 Central 的 <latest> 是"最后部署"不是"版本号最大"）。
             2026-09-26 23:15:07–23:15:32 逐坐标实测 README 表里的全部 19 个坐标：5 格落后
             （z-config 1.0.7→1.0.8 / z-cache 1.3.1→1.3.5 / z-mq 1.2.0→1.2.1 /
               z-gw 1.0.1→1.0.3 / z-vector 1.0.1→1.0.3），已抬；抬后 LAG 0 / AHEAD 0。
             尺 = ~/.cache/zboot-1016/latest-census.py（自带一支 CTRL：把 z-cache 退回 1.3.1 必须
             重新进 LAG 名单，否则"落后 0 条"和"尺看不见落后"是同一个输出），
             读数留档 = ~/.cache/zboot-1016/latest-census.receipt。
             ⚠ 这五格抬的是**仓内** property：repo1 上已发布的 z-boot:1.0.16 各 starter 仍折进的是
             抬之前的旧值（1.0.7/1.3.1/1.2.0/1.0.1/1.0.1），对外要等下一次发布才兑现。
             这条"仓内 vs 发布件"的分叉不许靠眼睛记，尺 = ~/.cache/zboot-1016/pin-fork-check.py。 -->
        <z-config.version>1.0.8</z-config.version>
        <z-ctc.version>1.0.1</z-ctc.version>
        <z-cache.version>1.3.5</z-cache.version>
        <z-mq.version>1.2.1</z-mq.version>
        <z-gw.version>1.0.3</z-gw.version>
        <z-kb.version>1.0.2</z-kb.version>
        <z-vector.version>1.0.3</z-vector.version>
        <z-graph.version>1.0.5</z-graph.version>
        <z-rpc.version>1.0.2</z-rpc.version>
        <z-oss.version>1.0.2</z-oss.version>
        <z-schedule.version>1.0.4</z-schedule.version>
        <z-msg.version>1.2.0</z-msg.version>
        <!-- z-msg 1.2.0 已发 Central（2026-09-26 20:09 repo1 实测 api/core/web/channels/ws/im 六件 jar+pom 全 200）。
             相比 1.1.0 的两处行为变更都在这条 pin 可达的范围内或紧邻：core 的 RealtimeTicketService 票一次性消费
             （web 侧只有 javadoc 变更），im 的 /history 改成带 nextSinceSeq/hasMore/headSeq/minVisibleSeq 的对象。 -->
        <!-- z-script 1.0.0 实测已在 Central：repo1 的 z-script/{z-script-web,z-script-core,z-script-engine}
             pom+jar 均 200，且空仓 `dependency:resolve io.github.yuku123:z-script-web:1.0.0` BUILD SUCCESS
             （落地 16 个 io.github.yuku123 jar）。此前这里写的"从未发布 (repo1 404)"是 2026-09-23 的旧口径。 -->
        <z-script.version>1.0.0</z-script.version>

        <!-- L3 Agent/AI 生态版本 (FEATURE066 7 仓矩阵) -->
        <z-agent-kernel.version>0.1.1</z-agent-kernel.version>
        <z-llm.version>0.1.4</z-llm.version>
        <z-mcp.version>0.1.2</z-mcp.version>
        <z-skill.version>0.1.2</z-skill.version>
        <z-agent.version>0.1.2</z-agent.version>
        <z-bot.version>0.1.0</z-bot.version>
        <z-agent-proxy.version>0.1.0</z-agent-proxy.version>

        <!-- Maven 插件版本 -->
        <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
        <maven-source-plugin.version>3.3.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
        <central-publishing-plugin.version>0.8.0</central-publishing-plugin.version>
        <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
    </properties>

    <profiles>
        <profile>
            <id>central</id>
            <properties>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>${maven-deploy-plugin.version}</version>
                        <configuration><skip>true</skip></configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                                <arg>--no-tty</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <waitUntil>uploaded</waitUntil>
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <!--
                flatten-maven-plugin: ${revision} 在 deploy 前替换为字面版本号
                - updatePomFile=true 写入原 pom（子模块继承 ${revision} 才能 compile）
                - flattenMode=oss 子 POM 完全 self-contained + 自定义 ${xxx} 解析 + 元数据保留
                  (详见 lead/005_技术架构/004_flatten_maven_plugin_模式选择.md)
                - <properties>keep 不是可选项：oss 默认把 <properties> 整个剥掉，于是外部 import
                  z-boot-dependencies 的工程在解析 BOM 时读不到父 pom 的 property，那几条
                  ${z-*.version} 受管项当场是 Maven 模型错误而不是"没管"。reactor 内解析得到，
                  所以本机永远看不出来——只有从 repo1 拉发布件才暴露（1.0.15 实测：
                  z-graph-api/core/protocol 三条，报错定位到 BOM pom line 977）。
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>oss</flattenMode>
                    <pomElements>
                        <properties>keep</properties>
                    </pomElements>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>