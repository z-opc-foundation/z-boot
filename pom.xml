<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-boot 是 z-opc-foundation 的版本权威 (BOM) 自给自足, 不依赖任何 z-opc 业务模块。

        2026-09-28 改造(照 ../idea_workplace/c2f-boot 的形状):本 pom 只做**已发布的 parent**,
        不再有 <modules>。每个文件夹都是一个独立可发的 Maven 工程,发版只发需要发的那个文件夹。

        ⚠ 2026-10-08「火车制」重构后,上面那套四文件夹形状已被取代 —— 现在盘上只有三个:
            z-boot-parent               唯一消费入口(地板 + 接入面 + 自家 starter 全在它 DM 里)
            z-boot-starter               z-boot-base / -web-starter / -datasource-starter
            z-boot-integration-starters  19 个 L3 聚合 starter,叶子各自 import parent 一条
        z-boot-dependencies / z-boot-fleet 两个文件夹已随 1.1.0 火车退役(Central 旧件永久在架,
        未迁移的消费方照常解析),其内容逐字并进 z-boot-parent。见 README「火车制重构」一节。

        版本不再是全局一个 ${revision}:每个工程自带字面 <version>,parent 版本只在 parent 内容
        真的变了才抬。于是「z-ctc 发了 1.0.2」不再牵动地板 BOM、不再牵动其余 18 个 starter。

        发版尺 = mvn/deploy.sh <folder...>(见 README「发布」),凭证走仓根 .env + ./.gnupg。
    -->
    <groupId>io.github.yuku123</groupId>
    <artifactId>z-boot</artifactId>
    <version>1.0.19</version>
    <packaging>pom</packaging>

    <name>z-boot (Starter Parent + BOM Authority)</name>
    <description>z-opc-foundation 的 Spring Boot Starter 聚合 + 第三方依赖版本权威 (BOM)</description>
    <url>https://github.com/z-opc-foundation/z-boot</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-boot.git</connection>
        <developerConnection>scm:ssh://git@github.com/z-opc-foundation/z-boot.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-boot</url>
        <tag>HEAD</tag>
    </scm>

    <!--
      这里不放 <modules>:发版按文件夹为单位(mvn/deploy.sh),整仓构建也走 mvn/install.sh。
      z-boot 子模块的 dependencyManagement 在各叶子 pom 自己声明 (import z-boot-dependencies
      + z-boot-fleet 两个字面版本), 形成 self-contained 的发布件。
      第三方受管项 → z-boot-dependencies;兄弟仓受管项 → z-boot-fleet。两者坐标空间不相交。
    -->

    <properties>
        <!-- JDK / 编译 -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 兄弟仓 (z-* L3) 的版本格不在这里 —— 见 z-boot-fleet/pom.xml(由
             _doc/003_script/gen_train_bom.py 生成并逐件对 repo1 复核)。 -->

        <!-- Maven 插件版本 -->
        <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
        <maven-source-plugin.version>3.3.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
        <central-publishing-plugin.version>0.8.0</central-publishing-plugin.version>
        <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
    </properties>


    <profiles>
        <profile>
            <id>central</id>
            <properties>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>${maven-deploy-plugin.version}</version>
                        <configuration><skip>true</skip></configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                            <!--
                                2026-10-22：改走仓内 wrapper 喂 passphrase（org 统一做法，从 z-util/z-team 照搬）。
                                为什么必须换：maven-gpg-plugin 3.2.7 的 gpgArguments 里那个
                                「pinentry-mode loopback」只解决「gpg 要问口令」，**口令本身仍无处可取** ——
                                它不读 -Dgpg.passphrase / -Dgpg.passphraseFile（注释见 z-team 根 pom 同处），
                                headless macOS 上走 gpg-agent 一律撞「No pinentry」，
                                而本仓 settings.xml 里**没有** gpg.passphrase（central server 只有用户名/口令）。
                                ⇒ 旧配置在本机根本签不出来（1.1.2 就是这么只进了本地 m2、没进中央）。
                                wrapper 自加载仓根 .env 的 CENTRAL_GPG_PASSPHRASE / GPG_PASSPHRASE，
                                强制 batch + loopback，让插件签任何文件都无声交付。
                                ⚠ 路径：不能用 ${maven.multiModuleProjectDirectory} —— 它指向**被发模块目录**
                                （本仓按文件夹发版 ⇒ 它是 z-boot-parent/），脚本在**仓根** _doc/003_script/ 下。
                                ⚠ 2026-10-22 23:30 实测修正：原来用 ${project.basedir}/../ 定位仓根，
                                但 ${project.basedir} 是**当前模块**目录 —— 对聚合器子模块
                                （z-boot-base / z-boot-datasource-starter / z-boot-web-starter …）
                                它解析成 <发版文件夹>/<子模块>/../_doc = <发版文件夹>/_doc ⇒ **不存在**
                                ⇒ 首次 1.1.2 实发就死在 gpg:sign：「Cannot run program .../z-boot-base/../_doc/...:
                                error=2, No such file or directory」。
                                ⇒ 改用**会话级** ${session.executionRootDirectory}（= 本次 mvn 启动所在目录，
                                本仓按文件夹发版 ⇒ 它就是 z-boot-starter/ 或 z-boot-integration-starters/）
                                ⇒ 再 ../ 定位仓根，对**聚合器与它的每一个子模块**同时成立。
                                ⚠ 但 ${session.executionRootDirectory} 是**本次 mvn 启动所在目录**：
                                  按文件夹发版时它是 z-boot-parent/ 或 z-boot-starter/ 等，
                                  `../_doc` 恰好能命中；可**根 pom 自己**（folder = "."）
                                  的 executionRootDirectory 就是**仓根**，`../_doc` 会指到**仓外**
                                  ⇒ 「Cannot run program .../z-boot/../_doc/...: error=2,
                                  No such file or directory」。
                                ⇒ 改用 Maven 注入的 **${maven.multiModuleProjectDirectory}**
                                  （= 本次 mvn 的**仓根**，与启动目录无关）：
                                  聚合器与它的每一个子模块、父 pom 与根 pom **同时成立**。
                                  （2026-10-30 实测：root 与 parent 同批发布，root 挂、parent 过。）
                            -->
                            <executable>${maven.multiModuleProjectDirectory}/_doc/003_script/gpg-with-passphrase.sh</executable>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <waitUntil>uploaded</waitUntil>
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <!--
                flatten-maven-plugin: 把发布件 pom 收成 self-contained 的 oss 形状
                - flattenMode=oss 剥掉 <build>/<profiles>/<pluginManagement>,保留依赖/受管项与
                  licenses/scm/developers 元数据(详见 lead/005_技术架构/004_flatten_maven_plugin_模式选择.md)
                - updatePomFile=true 让 install/deploy 用扁平 pom(.flattened-pom.xml)
                - <properties>keep 不是可选项：oss 默认把 <properties> 整个剥掉,于是外部 import
                  本 BOM 的工程在解析受管项时读不到 property,那几条 ${z-*.version} 当场是 Maven
                  模型错误而不是"没管"。reactor 内解析得到,所以本机永远看不出来——只有从 repo1 拉
                  发布件才暴露（1.0.15 实测:z-graph-api/core/protocol 三条,报错定位到 BOM pom line 977）。
                  1.0.19 起这些 property 就在 z-boot-fleet 自己身上,不再靠父 pom 兜。
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>oss</flattenMode>
                    <pomElements>
                        <properties>keep</properties>
                    </pomElements>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>