<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-boot 是 z-opc-foundation 的版本权威 (BOM) 自给自足, 不依赖任何 z-opc 业务模块。
        发版模式：reversion (CI-friendly versions) + flatten-maven-plugin。
        发版只需改顶层 <revision>X.Y.Z</revision> 一处。
    -->
    <groupId>io.github.yuku123</groupId>
    <artifactId>z-boot</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>z-boot (Starter Parent + BOM Authority)</name>
    <description>z-opc-foundation 的 Spring Boot Starter 聚合 + 第三方依赖版本权威 (BOM)</description>
    <url>https://github.com/z-opc-foundation/z-boot</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-boot.git</connection>
        <developerConnection>scm:ssh://git@github.com/z-opc-foundation/z-boot.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-boot</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>z-boot-starter</module>
        <module>z-boot-dependencies</module>
        <module>z-boot-integration-starters</module>
    </modules>

    <!--
      z-boot 子模块的 dependencyManagement 在各子 pom 自己声明 (import z-boot-dependencies BOM).
      z-opc 等消费者通过 import z-boot-dependencies BOM 也能拿到版本约束.
      这里不放 import 是为了避免与子模块自身继承形成 cycle.
    -->

    <properties>
        <!-- 项目自身版本（CI-friendly versions 根，发版改这一处即可） -->
        <revision>1.0.14</revision>

        <!-- JDK / 编译 -->
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- z-opc-foundation 生态版本（消费者也通过 properties 引用）；对账基准 = Maven Central latest (2026-09-23) -->
        <z-config.version>1.0.7</z-config.version>
        <z-ctc.version>1.0.1</z-ctc.version>
        <z-cache.version>1.3.1</z-cache.version>
        <z-mq.version>1.2.0</z-mq.version>
        <z-gw.version>1.0.1</z-gw.version>
        <z-kb.version>1.0.2</z-kb.version>
        <z-vector.version>1.0.1</z-vector.version>
        <z-graph.version>1.0.3</z-graph.version>
        <z-rpc.version>1.0.2</z-rpc.version>
        <z-oss.version>1.0.2</z-oss.version>
        <z-schedule.version>1.0.4</z-schedule.version>
        <z-msg.version>1.0.0</z-msg.version>
        <!-- z-script 从未发布 Central (repo1 404, 2026-09-23 实测), 仅 depMgmt 占位无消费者解析 -->
        <z-script.version>1.0.0</z-script.version>

        <!-- L3 Agent/AI 生态版本 (FEATURE066 7 仓矩阵) -->
        <z-agent-kernel.version>0.1.1</z-agent-kernel.version>
        <z-llm.version>0.1.4</z-llm.version>
        <z-mcp.version>0.1.2</z-mcp.version>
        <z-skill.version>0.1.2</z-skill.version>
        <z-agent.version>0.1.2</z-agent.version>
        <z-bot.version>0.1.0</z-bot.version>
        <z-agent-proxy.version>0.1.0</z-agent-proxy.version>

        <!-- Maven 插件版本 -->
        <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
        <maven-source-plugin.version>3.3.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
        <central-publishing-plugin.version>0.8.0</central-publishing-plugin.version>
        <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
    </properties>

    <profiles>
        <profile>
            <id>central</id>
            <properties>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>${maven-deploy-plugin.version}</version>
                        <configuration><skip>true</skip></configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                                <arg>--no-tty</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <waitUntil>uploaded</waitUntil>
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <!--
                flatten-maven-plugin: ${revision} 在 deploy 前替换为字面版本号
                - updatePomFile=true 写入原 pom（子模块继承 ${revision} 才能 compile）
                - flattenMode=oss 子 POM 完全 self-contained + 自定义 ${xxx} 解析 + 元数据保留
                  (详见 lead/005_技术架构/004_flatten_maven_plugin_模式选择.md)
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>