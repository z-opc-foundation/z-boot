<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot</artifactId>
        <version>1.0.19</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    

    <artifactId>z-boot-starter</artifactId>
    <version>1.1.1</version>
    <name>z-boot-starter (Aggregator)</name>
    <packaging>pom</packaging>

    <modules>
        <module>z-boot-base</module>
        <module>z-boot-datasource-starter</module>
        <module>z-boot-web-starter</module>
    </modules>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- 这里**不要** import z-boot-parent 的 BOM（2026-10-06 试过，又撤掉了）。
         起因是 z-boot-web-starter 曾声明一条"不写版本"的 z-boot-jackson-starter 依赖，
         而本容器的 parent 链是 z-boot-starter → 根 z-boot，不经过 z-boot-parent ⇒ 版本无从供给。
         两种解法都试过：import 进来能编过，但 (a) 它只为供这一个版本号，
         (b) import 依赖不支持 <relativePath>，等于给发布加了"parent 必须先于 starter"的硬顺序约束。
         最后选的解法是把 jackson 规则**内化进 z-boot-web-starter 本身**（模块已删除），
         依赖环与缺版本一并消失，这里也就不需要 BOM 了。 -->
</project>