<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-starter</artifactId>
        <version>1.0.22</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    

    <artifactId>z-boot-web-starter</artifactId>
    <version>1.0.22</version>
    <name>z-boot-web-starter</name>
    <description>z-boot Web starter — 装配 spring-boot-starter-web + log4j2 + knife4j OpenAPI 3。</description>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-boot.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-boot.git</developerConnection>
        <url>https://github.com/yuku123/z-boot</url>
        <tag>HEAD</tag>
    </scm>
    <url>https://github.com/yuku123/z-boot</url>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-dependencies</artifactId>
                <version>1.0.20</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 兄弟仓(z-* L3)版本权威:与地板坐标空间不相交,抬兄弟版只重发 fleet -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-fleet</artifactId>
                <version>1.0.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
            <!-- spring-boot-starter-log4j2（2.7.x）默认带的是 1.x 转接器
                 org.apache.logging.log4j:log4j-slf4j-impl（artifact 名不带 2），与 slf4j-api 2.x
                 共存时 SLF4J 2.x 的 ServiceLoader 找不到 provider、1.x 的桥走 StaticLoggerBinder
                 编译期又指向 slf4j 2.x 类型——NCDFE 爆点。
                 2026-10-02：显式排 1.x 桥并补 log4j-slf4j2-impl（2.x 桥）作 compile 直依赖——
                 每个消费 z-boot-web-starter 的模块都「自然」拿到正确绑定，**不需要**在依赖它的
                 库（z-mist-web / z-oss-api / z-agent-center-web / z-wf-starter / z-vector-* …）
                 或最终应用（z-opc main-starter）的 pom 上再手动加 <exclusion>log4j-slf4j-impl</exclusion>
                 。这是「库件不替应用写日志栈」原则的源头在 z-boot 自己的落地。 -->
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
        </dependency>

        <!-- Long→String 统一序列化（2026-10-03 补上平台接线，此前规则写好了但零个服务继承到）
             规则本体在 z-boot-jackson-starter 的 GlobalJacksonConfig，它有正规
             META-INF/spring.factories 自动配置登记，发布件 1.0.22 已实测含
             longAsStringCustomizer + LongToStringSerializer。问题出在**没人依赖它**：
             全仓除聚合 pom 外无一处声明该坐标，z-boot-web-starter 也没引，
             于是所有 web 服务实际都没拿到这条规则——各服务于是各自在本地
             JacksonConfig 里手写一份（z-team 就是这么长出来的），彼此口径还不一样。

             雪花 ID 是 19 位（~2.1e18），超过 JS Number 的 53 位有效位，
             后端按 JSON 数字写出时浏览器 JSON.parse 在词法阶段就舍掉末位、原值不可恢复
             （实测 Number("2096058642985349121") === 2096058642985349000），
             前端拿抹平后的 ID 回查必然「项目不存在」。

             这条不是「集成型 starter」那种可选能力，是每个 web 服务的底线正确性保证，
             所以下沉到基础件 z-boot-web-starter：所有 web 服务已经依赖它，加这一条即全体继承，
             不用每个服务各写一遍、也不会漏。版本由 z-boot-parent 的 ${z-boot.version} 统一管理。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-jackson-starter</artifactId>
        </dependency>

        <!-- knife4j / springdoc 的版本由上面 import 的 z-boot-dependencies BOM 唯一供给
             （${knife4j-openapi3.version}）。这里再写一份字面量，就会和 BOM 各说各话：
             消费者按 BOM 编译、本 starter 按这一行装配。 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-spring-boot-starter</artifactId>
        </dependency>

    </dependencies>

</project>