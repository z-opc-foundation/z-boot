<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-starter</artifactId>
        <version>1.0.20</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    

    <artifactId>z-boot-base</artifactId>
    <version>1.0.20</version>
    <name>z-boot-base</name>
    <description>z-boot 基础 starter — 提供 log4j2 日志门面、常用配置基线、通用异常处理入口。</description>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-boot.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-boot.git</developerConnection>
        <url>https://github.com/yuku123/z-boot</url>
        <tag>HEAD</tag>
    </scm>
    <url>https://github.com/yuku123/z-boot</url>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    
        <log4j2.version>2.25.4</log4j2.version>
    </properties>

        <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-dependencies</artifactId>
                <version>1.0.19</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 兄弟仓(z-* L3)版本权威:与地板坐标空间不相交,抬兄弟版只重发 fleet -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-fleet</artifactId>
                <version>1.0.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Log4j2 API:提供 import org.apache.logging.log4j.Logger / LogManager -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j2.version}</version>
        </dependency>
    </dependencies>

</project>